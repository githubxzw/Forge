[Unit]
Description=Forge Build & Deploy Platform
After=network.target

[Service]
Type=simple
# 建议创建专用用户运行：useradd -r -m -d /opt/forge forge
User=forge
WorkingDirectory=/opt/forge
Environment=FORGE_DATA_DIR=/opt/forge/data
# 首次启动前设置管理员密码（启动后可删除此行）
Environment=FORGE_ADMIN_PASSWORD=change-me-on-first-run
# 公网部署务必改为你的域名
# Environment=FORGE_ALLOWED_ORIGINS=https://forge.example.com
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/forge/forge-server.jar --server.port=8080
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
